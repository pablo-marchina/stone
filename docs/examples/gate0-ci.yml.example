# EXEMPLO DESATIVADO — não habilitar em repo privado sem controle de cobrança.
name: Gate 0 — baseline técnico
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install
        run: python -m pip install -e '.[dev]'
      - name: Verify plan and default-deny
        run: python scripts/check_gate0.py
      - name: Tests
        run: python -m pytest -q
