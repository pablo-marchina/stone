TAPI_ENV=local
TAPI_EXTERNAL_OPERATIONS_ENABLED=false
TAPI_FINANCIAL_BUDGET_BRL=0
TAPI_PAID_API_MONTHLY_LIMIT_BRL=0
TAPI_PAID_API_PER_RUN_LIMIT_BRL=0
TAPI_PAID_AD_SPEND_LIMIT_BRL=0
# Somente ao iniciar banco Docker local: definir via .env não versionado
# TAPI_DB_PASSWORD=<configure localmente>

# Secure identity + database mode (local example only)
# TAPI_DATABASE_URL=sqlite:////absolute/path/to/local_secure.sqlite3
# TAPI_ALLOW_HTTP_LOOPBACK=1  # never enable on a public host
# TAPI_ALLOW_SCHEMA_INIT=1  # explicit initial bootstrap only

# Official metadata adapters: OFF by default. Never store real credentials here.
# Before enabling, separately verify platform-free quotas, no billing and no overage.
TAPI_OFFICIAL_METADATA_READS=0
TAPI_ZERO_BILLING_CONFIRMED=0
# Configure secrets only in a protected environment, NEVER in this file/Git:
# TAPI_INSTAGRAM_ACCESS_TOKEN=<secret only in environment>
# TAPI_YOUTUBE_ACCESS_TOKEN=<secret only in environment>
# Optional permitted local media root; never a remote URL:
# TAPI_APPROVED_MEDIA_ROOT=/path/to/rights-approved-local-media

# Experimental MPE-targeted metadata persistence: MUST remain OFF until rights,
# per-source admin grant, corpus registration and migrations 0005/0006 are verified.
TAPI_MPE_PERSISTENCE_ENABLED=0
# Private local paths configured only on the server; DO NOT commit approval proof.
# TAPI_MPE_APPROVED_FRAME_PATH=/private/mpe_approved_sources.json
# TAPI_MPE_APPROVAL_PROOFS_DIR=/private/mpe_approvals

# DEC-017 E1 — typed System One local experiment. OFF by default; no remote weights.
TAPI_SYSTEM_ONE_ENABLED=0
# Never store model weights, access tokens or rights documents in Git.
# TAPI_SYSTEM_ONE_LOCAL_MODEL_DIR=/path/to/preapproved/offline/gliner2.5-multi-decide
