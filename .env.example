TAPI_ENV=local
TAPI_EXTERNAL_OPERATIONS_ENABLED=false
TAPI_FINANCIAL_BUDGET_BRL=0
TAPI_PAID_API_MONTHLY_LIMIT_BRL=0
TAPI_PAID_API_PER_RUN_LIMIT_BRL=0
TAPI_PAID_AD_SPEND_LIMIT_BRL=0
# Somente ao iniciar banco Docker local: definir via .env não versionado
# TAPI_DB_PASSWORD=<configure localmente>

# Secure identity + database mode (local example only)
# TAPI_DATABASE_URL=sqlite:////absolute/path/to/local_secure.sqlite3
# TAPI_ALLOW_HTTP_LOOPBACK=1  # never enable on a public host
# TAPI_ALLOW_SCHEMA_INIT=1  # explicit initial bootstrap only